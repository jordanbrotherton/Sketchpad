[sub_resource type="Shader" id="Shader_qnw5l"]
code = "// NOTE: Shader automatically converted from Godot Engine 4.6.3.stable's CanvasItemMaterial.

shader_type canvas_item;
render_mode blend_mix;

uniform vec2 scroll_speed = vec2(0.05, 0.05);
uniform vec2 scale_factor = vec2(10.0, 10.0);
uniform sampler2D scroll_texture : repeat_enable, filter_linear;

void fragment() {
	vec2 uv = vec2((UV.x * scale_factor.x) + (scroll_speed.x * TIME), UV.y);
	COLOR = texture(scroll_texture, uv);
}"

